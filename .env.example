# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Backend base URL — switch between local and production here.
# Production: https://back-end-zdip.onrender.com
# Local:      http://localhost:8000
VITE_API_BASE_URL=https://back-end-zdip.onrender.com

# Bearer token for the current learner/reviewer session.
# Leave empty to run the app in local Preview mode with seed data only.
VITE_API_TOKEN=
