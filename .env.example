# Copy this file to .env (or .env.local) and adjust as needed.
# Base URL of the approved Laravel API. Set this for your current environment.
# Production builds fail clearly when this is missing; do not rely on an old Render host.
# React never talks to FastAPI directly - every request goes through Laravel.
VITE_API_BASE_URL=

# Google Identity Services client ID, used by the "Continue with Google"
# login button (Google Cloud Console > APIs & Services > Credentials).
# Required for src/Login.jsx to be able to initialize Google Sign-In.
VITE_GOOGLE_CLIENT_ID=
